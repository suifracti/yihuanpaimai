{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geometry_contract_v1.schema.json",
  "title": "Vision Benchmark source-relative physical item geometry contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "pathBase",
    "sources",
    "instances",
    "queueSlots"
  ],
  "properties": {
    "contractVersion": {
      "const": "geometry-contract-v1"
    },
    "pathBase": {
      "const": "repository_root"
    },
    "description": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "instances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/physicalItemInstance"
      }
    },
    "queueSlots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/queueSlot"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourcePath",
        "width",
        "height",
        "sceneType",
        "inventoryEligible",
        "inventoryRoi",
        "coordinateSpace"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "sceneType": {
          "type": "string",
          "minLength": 1
        },
        "inventoryEligible": {
          "type": "boolean"
        },
        "inventoryRoi": {
          "oneOf": [
            {
              "$ref": "#/$defs/roi"
            },
            {
              "type": "null"
            }
          ]
        },
        "coordinateSpace": {
          "type": "string",
          "const": "source_pixel"
        }
      }
    },
    "roi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height",
        "coordinateSpace"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "coordinateSpace": {
          "type": "string",
          "const": "source_pixel"
        }
      }
    },
    "physicalItemInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "sourceId",
        "bbox",
        "bboxCoordinateSpace",
        "footprint",
        "canonicalItemId",
        "observationLabel",
        "contentVerification"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "pattern": "^inst-[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "$comment": "Opaque physical-instance identity; semantic/model labels belong in observationLabel."
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "bboxCoordinateSpace": {
          "type": "string",
          "const": "source_pixel"
        },
        "footprint": {
          "oneOf": [
            {
              "$ref": "#/$defs/footprint"
            },
            {
              "type": "null"
            }
          ]
        },
        "canonicalItemId": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^image[0-9]+-[0-9]+-[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observationLabel": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "$comment": "A model or reviewer description only; never a physical-instance identifier."
        },
        "contentVerification": {
          "$ref": "#/$defs/contentVerification"
        }
      }
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4,
      "$comment": "[x1, y1, x2, y2], right and bottom exclusive, in stored source pixels."
    },
    "footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "widthCells",
        "heightCells"
      ],
      "properties": {
        "widthCells": {
          "type": "integer",
          "minimum": 1
        },
        "heightCells": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "contentVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentVerified",
        "reviewStatus",
        "evidenceType",
        "scope",
        "note"
      ],
      "properties": {
        "contentVerified": {
          "type": "boolean"
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "pending_review",
            "reviewed_consistent",
            "rejected"
          ]
        },
        "evidenceType": {
          "type": "string",
          "enum": [
            "none",
            "manual_review",
            "independent_evidence"
          ]
        },
        "scope": {
          "const": "crop_instance_binding_only"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "queueSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queueId",
        "instanceId",
        "cropPath"
      ],
      "properties": {
        "queueId": {
          "type": "string",
          "minLength": 1
        },
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "cropPath": {
          "type": "string",
          "minLength": 1
        },
        "legacyLocalOrdinal": {
          "type": [
            "string",
            "null"
          ],
          "$comment": "Optional trace metadata only; never used for joining."
        }
      }
    }
  }
}
