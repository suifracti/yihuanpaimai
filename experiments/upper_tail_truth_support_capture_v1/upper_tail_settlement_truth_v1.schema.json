{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yihuan.local/schemas/upper-tail-settlement-truth.v1.json",
  "title": "Upper-tail Settlement Truth v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contractVersion", "truthId", "matchId", "reviewClass", "reviewedAt",
    "predictionCaptureRef", "verifiedState", "truthEvidenceReferences",
    "actualValueDecomposition", "truthHash", "artifactSha256"
  ],
  "properties": {
    "schemaVersion": {"const": "upper-tail-settlement-truth.v1"},
    "contractVersion": {"const": 1},
    "truthId": {"type": "string", "pattern": "^utst_[0-9a-f]{32}$"},
    "matchId": {"type": "string", "minLength": 1},
    "reviewClass": {"enum": ["CONTRACT_VALID_FIXTURE", "INDEPENDENT_REVIEWED_SETTLEMENT"]},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "predictionCaptureRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captureId", "predictionHash", "artifactSha256"],
      "properties": {
        "captureId": {"type": "string", "pattern": "^utsc_[0-9a-f]{32}$"},
        "predictionHash": {"$ref": "#/$defs/sha256"},
        "artifactSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verifiedState": {
      "type": "object",
      "required": ["g", "p", "r", "verificationStatus", "verification"],
      "properties": {
        "g": {"type": "integer", "minimum": 0},
        "p": {"type": "integer", "minimum": 0},
        "r": {"type": "integer", "minimum": 0},
        "verificationStatus": {"const": "VERIFIED"},
        "verification": {
          "type": "object",
          "required": ["method", "version", "reviewer"],
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "reviewer": {
              "type": "object",
              "required": ["type", "id"],
              "properties": {
                "type": {"const": "reviewer"},
                "id": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "truthEvidenceReferences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/truthReference"}},
    "actualValueDecomposition": {
      "type": "object",
      "required": ["scope", "actualTotal", "decompositionStatus", "components", "unattributedValue", "reconciliationDelta"],
      "properties": {
        "scope": {"const": "full_inventory"},
        "actualTotal": {"type": "number", "exclusiveMinimum": 0},
        "decompositionStatus": {"enum": ["COMPLETE", "PARTIAL"]},
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/actualComponent"}},
        "unattributedValue": {"type": "number", "minimum": 0},
        "reconciliationDelta": {"type": "number"}
      }
    },
    "truthHash": {"$ref": "#/$defs/sha256"},
    "artifactSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {
      "type": "object",
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "truthReference": {
      "allOf": [{"$ref": "#/$defs/reference"}],
      "type": "object",
      "required": ["uri", "sha256", "truthPayloadSha256"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "truthPayloadSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "actualComponent": {
      "type": "object",
      "required": ["componentId", "category", "value", "evidenceReferences"],
      "properties": {
        "componentId": {"type": "string", "minLength": 1},
        "category": {"enum": ["gold", "purple", "red", "lowTier", "welfare", "other"]},
        "value": {"type": "number", "minimum": 0},
        "evidenceReferences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}}
      }
    }
  }
}
