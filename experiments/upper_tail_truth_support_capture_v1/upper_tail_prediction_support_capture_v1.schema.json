{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yihuan.local/schemas/upper-tail-prediction-support-capture.v1.json",
  "title": "Upper-tail Prediction Support Capture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contractVersion", "captureId", "matchId", "collectionClass", "matchBinding", "capturePhase", "capturedAt",
    "predictionSnapshot", "predictionSnapshotSha256", "candidateSpace",
    "supportIntegrity", "aggregateDistribution", "predictionHash", "artifactSha256"
  ],
  "properties": {
    "schemaVersion": {"const": "upper-tail-prediction-support-capture.v1"},
    "contractVersion": {"const": 1},
    "captureId": {"type": "string", "pattern": "^utsc_[0-9a-f]{32}$"},
    "matchId": {"type": "string", "minLength": 1},
    "collectionClass": {"enum": ["CONTRACT_VALID_FIXTURE", "RUNTIME_SMOKE_CAPTURE", "NATURAL_RUNTIME_CAPTURE"]},
    "matchBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "runtimeMatchId", "predictionSnapshotMatchId"],
      "properties": {
        "status": {"enum": ["EXACT_SNAPSHOT_MATCH", "RUNTIME_CONTEXT_BINDING"]},
        "runtimeMatchId": {"type": "string", "minLength": 1},
        "predictionSnapshotMatchId": {"type": "string", "minLength": 1}
      }
    },
    "capturePhase": {"const": "PREDICTION_COMPLETED_PRE_SETTLEMENT"},
    "capturedAt": {"type": "string", "format": "date-time"},
    "predictionSnapshot": {"type": "object"},
    "predictionSnapshotSha256": {"$ref": "#/$defs/sha256"},
    "candidateSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullStateCount", "valuationStateCount", "compressionApplied", "resolverVersion", "fullCandidateStates", "valuationStates"],
      "properties": {
        "fullStateCount": {"type": "integer", "minimum": 1},
        "valuationStateCount": {"type": "integer", "minimum": 1},
        "compressionApplied": {"type": "boolean"},
        "resolverVersion": {"type": "string", "minLength": 1},
        "fullCandidateStates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fullState"}},
        "valuationStates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/valuationState"}}
      }
    },
    "supportIntegrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullCandidateStatesSha256", "valuationStatesSha256", "normalizedWeightsSha256", "valuationBreakdownsSha256", "tailContributionsSha256", "mixtureInputSha256"],
      "properties": {
        "fullCandidateStatesSha256": {"$ref": "#/$defs/sha256"},
        "valuationStatesSha256": {"$ref": "#/$defs/sha256"},
        "normalizedWeightsSha256": {"$ref": "#/$defs/sha256"},
        "valuationBreakdownsSha256": {"$ref": "#/$defs/sha256"},
        "tailContributionsSha256": {"$ref": "#/$defs/sha256"},
        "mixtureInputSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "aggregateDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantiles", "sourceStateIds", "quantileProvenance"],
      "properties": {
        "quantiles": {"$ref": "#/$defs/quantiles"},
        "sourceStateIds": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "quantileProvenance": {
          "type": "object",
          "required": ["method", "version", "mixtureInputSha256", "p20", "p50", "p80"],
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "mixtureInputSha256": {"$ref": "#/$defs/sha256"},
            "p20": {"$ref": "#/$defs/quantileTrace"},
            "p50": {"$ref": "#/$defs/quantileTrace"},
            "p80": {"$ref": "#/$defs/quantileTrace"}
          }
        }
      }
    },
    "predictionHash": {"$ref": "#/$defs/sha256"},
    "artifactSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "geometry": {
      "type": "object",
      "required": ["g", "p", "r"],
      "properties": {
        "g": {"type": "integer", "minimum": 0},
        "p": {"type": "integer", "minimum": 0},
        "r": {"type": "integer", "minimum": 0}
      }
    },
    "fullState": {
      "allOf": [{"$ref": "#/$defs/geometry"}],
      "type": "object",
      "required": ["stateId", "g", "p", "r", "provenance"],
      "properties": {
        "stateId": {"type": "string", "minLength": 1},
        "g": {"type": "integer", "minimum": 0},
        "p": {"type": "integer", "minimum": 0},
        "r": {"type": "integer", "minimum": 0},
        "provenance": {"type": "object"}
      }
    },
    "valuationState": {
      "type": "object",
      "required": ["stateId", "sourceFullStateIds", "g", "p", "r", "normalizedWeight", "valuationBreakdown", "tailContribution"],
      "properties": {
        "stateId": {"type": "string", "minLength": 1},
        "sourceFullStateIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "aggregationMethod": {"type": "string", "minLength": 1},
        "g": {"type": "integer", "minimum": 0},
        "p": {"type": "integer", "minimum": 0},
        "r": {"type": "integer", "minimum": 0},
        "normalizedWeight": {"type": "number", "minimum": 0, "maximum": 1},
        "valuationBreakdown": {"$ref": "#/$defs/valuationBreakdown"},
        "tailContribution": {"$ref": "#/$defs/tailContribution"}
      }
    },
    "valuationBreakdown": {
      "type": "object",
      "required": ["components", "total"],
      "properties": {
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/valuationComponent"}},
        "total": {"$ref": "#/$defs/range"}
      }
    },
    "valuationComponent": {
      "type": "object",
      "required": ["category", "lower", "mid", "upper", "provenance"],
      "properties": {
        "category": {"enum": ["gold", "purple", "red", "lowTier", "welfare", "other"]},
        "lower": {"type": "number", "minimum": 0},
        "mid": {"type": "number", "minimum": 0},
        "upper": {"type": "number", "minimum": 0},
        "provenance": {"type": "object", "required": ["method", "version"]}
      }
    },
    "range": {
      "type": "object",
      "required": ["lower", "mid", "upper"],
      "properties": {
        "lower": {"type": "number", "minimum": 0},
        "mid": {"type": "number", "minimum": 0},
        "upper": {"type": "number", "minimum": 0}
      }
    },
    "tailContribution": {
      "type": "object",
      "required": ["supportStatus", "distribution"],
      "properties": {
        "supportStatus": {"enum": ["SUPPORTED", "UNSUPPORTED"]},
        "reasonCode": {"type": ["string", "null"]},
        "distribution": {"oneOf": [{"$ref": "#/$defs/tailQuantiles"}, {"type": "null"}]},
        "provenance": {"type": "object"}
      }
    },
    "quantiles": {
      "type": "object",
      "required": ["p20", "p50", "p80"],
      "properties": {
        "p20": {"type": "number", "minimum": 0},
        "p50": {"type": "number", "minimum": 0},
        "p80": {"type": "number", "minimum": 0}
      }
    },
    "tailQuantiles": {
      "type": "object",
      "required": ["p20", "p50", "p80", "p95", "max"],
      "properties": {
        "p20": {"type": "number", "minimum": 0},
        "p50": {"type": "number", "minimum": 0},
        "p80": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "max": {"type": "number", "minimum": 0}
      }
    },
    "quantileTrace": {
      "type": "object",
      "required": ["sourceStateIds", "mixtureInputSha256"],
      "properties": {
        "sourceStateIds": {"type": "array", "items": {"type": "string"}},
        "mixtureInputSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
