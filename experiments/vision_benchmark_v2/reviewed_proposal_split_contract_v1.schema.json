{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.yihuan/benchmark/reviewed-proposal-split-v1.schema.json",
  "title": "Reviewed Proposal Split Contract v1",
  "description": "Reviewed source-pixel subdivision of one mixed production proposal without benchmark identity authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["splitVersion", "sourceId", "proposalArtifactPath", "proposalArtifactHash", "proposalId", "reviewStatus", "resolutionMethod", "children", "discardedRegions", "reviewEvidence"],
  "properties": {
    "splitVersion": {"const": "reviewed-proposal-split-v1"},
    "sourceId": {"type": "string", "minLength": 1},
    "proposalArtifactPath": {"type": "string", "minLength": 1},
    "proposalArtifactHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "proposalId": {"type": "string", "pattern": "^proposal-[A-Za-z0-9._:-]+$"},
    "reviewStatus": {"enum": ["pending_review", "reviewed_consistent", "rejected"]},
    "resolutionMethod": {"const": "reviewed_split"},
    "children": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/child"}
    },
    "discardedRegions": {
      "type": "array",
      "items": {"$ref": "#/$defs/discardedRegion"}
    },
    "reviewEvidence": {"$ref": "#/$defs/reviewEvidence"}
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "integer", "minimum": 0}
    },
    "cell": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "integer", "minimum": 0}
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["childId", "sourcePixelBbox", "sourceCells", "bboxCoordinateSpace", "coverageRole"],
      "properties": {
        "childId": {"type": "string", "pattern": "^split-child-[A-Za-z0-9._:-]+$"},
        "sourcePixelBbox": {"$ref": "#/$defs/bbox"},
        "sourceCells": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/cell"}},
        "bboxCoordinateSpace": {"const": "source_pixel"},
        "coverageRole": {"const": "physical_parent_fragment"}
      }
    },
    "discardedRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regionId", "sourcePixelBbox", "sourceCells", "bboxCoordinateSpace", "reason"],
      "properties": {
        "regionId": {"type": "string", "pattern": "^discard-[A-Za-z0-9._:-]+$"},
        "sourcePixelBbox": {"$ref": "#/$defs/bbox"},
        "sourceCells": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/cell"}},
        "bboxCoordinateSpace": {"const": "source_pixel"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceType", "sourceSnapshotPath", "reviewerRole", "note"],
      "properties": {
        "evidenceType": {"const": "manual_source_review"},
        "sourceSnapshotPath": {"type": "string", "minLength": 1},
        "reviewerRole": {"const": "human_reviewer"},
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
