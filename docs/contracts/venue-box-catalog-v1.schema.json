{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yihuanpaimai.local/schemas/venue-box-catalog-v1.schema.json",
  "title": "Venue / Box Catalog v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogVersion",
    "catalogStatus",
    "gameBuild",
    "generatedAt",
    "evidenceBundleSha256",
    "venues",
    "compatibilityTranslations"
  ],
  "properties": {
    "schemaVersion": { "const": "venue-box-catalog.v1" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "catalogStatus": { "enum": ["DRAFT", "APPROVED_FOR_ALPHA", "APPROVED_FOR_PRODUCTION"] },
    "gameBuild": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "evidenceBundleSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "venues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "venueId",
          "displayName",
          "selectable",
          "tier",
          "assetRequirement",
          "entryCost",
          "evidenceRefs",
          "observationAliases",
          "boxes"
        ],
        "properties": {
          "venueId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
          "displayName": { "type": "string", "minLength": 1 },
          "selectable": { "type": "boolean" },
          "tier": { "$ref": "#/$defs/nullableFact" },
          "assetRequirement": { "$ref": "#/$defs/nullableFact" },
          "entryCost": { "$ref": "#/$defs/nullableFact" },
          "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
          "observationAliases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "boxes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "boxId",
                "displayName",
                "effect",
                "evidenceRefs",
                "observationAliases",
                "membershipEvidenceClass",
                "textEvidenceClass",
                "operatorConfidence"
              ],
              "properties": {
                "boxId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
                "displayName": { "type": "string", "minLength": 1 },
                "effect": {
                  "type": "object",
                  "required": ["rawGameText", "normalizedSemantic", "normalizationEvidenceRefs"],
                  "properties": {
                    "rawGameText": { "type": ["string", "null"] },
                    "normalizedSemantic": { "type": ["string", "null"] },
                    "normalizationEvidenceRefs": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 },
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false
                },
                "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
                "membershipEvidenceClass": { "$ref": "#/$defs/evidenceClass" },
                "textEvidenceClass": { "$ref": "#/$defs/evidenceClass" },
                "operatorConfidence": { "enum": ["CONFIRMED", "PROBABLE", null] },
                "observationAliases": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "compatibilityTranslations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["consumer", "catalogVenueId", "status", "compatibilityValue"],
        "properties": {
          "consumer": { "enum": ["v06_python_adapter", "v06_js_adapter", "v06_solver"] },
          "catalogVenueId": { "type": "string", "minLength": 1 },
          "catalogVersion": { "type": "string", "minLength": 1 },
          "currentId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["EXPLICIT", "COMPATIBILITY_TRANSLATION", "UNRESOLVED"] },
          "compatibilityValue": { "type": ["string", "null"] },
          "translationVersion": { "type": "string", "minLength": 1 },
          "sourceAuthority": { "type": "string", "minLength": 1 },
          "sourceReference": { "type": "string", "minLength": 1 },
          "translationRef": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "nullableFact": {
      "type": "object",
      "required": ["status", "value", "evidenceRefs"],
      "properties": {
        "status": { "enum": ["VERIFIED", "UNKNOWN", "NOT_APPLICABLE", "NOT_GAME_AUTHORITY"] },
        "value": { "type": ["string", "number", "integer", "null"] },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "evidenceClass": {
      "enum": [
        "CURRENT_GAME_VALID",
        "CURRENT_GAME_OBSERVED",
        "OPERATOR_ASSERTED_CURRENT",
        "LEGACY_GAME_EVIDENCE",
        "DERIVED_ONLY",
        "USER_PROVIDED_TRUTH_CLUE",
        "UNVERIFIED"
      ]
    }
  },
  "additionalProperties": false
}
