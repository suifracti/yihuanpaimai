  "divergenceScenarios": [
    {
      "id": "D01_initial_state",
      "description": "Python starts ALLOW; the native machine starts FROZEN (SESSION_UNVERIFIED).",
      "python": { "isFrozen": false, "scanPermitted": true },
      "native": { "isFrozen": true, "scanPermitted": false },
      "contractGap": "CONTRACT_GAP-6",
      "resolution": "Native is fail-closed. Restart / resync must never default to the dangerous ALLOW state."
    },
    {
      "id": "D02_invalid_freeze_reason",
      "description": "Python silently reclassifies an unknown reason to USER_TAKEOVER and freezes; the native catalog returns null so the caller must refuse the event.",
      "python": { "freezeReason": "USER_TAKEOVER", "isFrozen": true },
      "native": { "tryParse": null },
      "contractGap": "CONTRACT_GAP-4",
      "resolution": "Native refuses to fabricate provenance. An unknown reason token is never mapped onto an existing reason."
    },
    {
      "id": "D03_repeated_freeze_side_effects",
      "description": "Python re-fires the halt callback, appends another freeze event and rewrites freeze_reason on every repeat; the native machine is idempotent on repeats.",
      "python": { "callbackInvocations": 3, "eventCount": 3, "freezeReason": "USER_TAKEOVER" },
      "native": { "freezeTransitionsApplied": 1, "activeReasons": ["FOCUS_LOST", "USER_TAKEOVER"] },
      "contractGap": "CONTRACT_GAP-2",
      "resolution": "Native fires the halt sink only on a real transition or reason-set growth, and keeps the full reason set instead of the last writer."
    },
    {
      "id": "D04_rearm_side_effects_and_counting",
      "description": "Python returns True and appends a rearm event on every call, including when the machine is not frozen; the native machine reports ALREADY_ALLOW and applies at most one transition.",
      "python": { "rearmWhileAllowReturns": true, "rearmCountAfterTwoCalls": 2 },
      "native": { "rearmWhileAllowOutcome": "ALREADY_ALLOW", "rearmAppliedCountAfterTwoCalls": 1 },
      "contractGap": "CONTRACT_GAP-3",
      "resolution": "Native treats a repeated rearm as a no-op on state while still recording the attempt."
    },
    {
      "id": "D05_per_reason_release_unavailable_in_python",
      "description": "Python exposes no API to release a single reason while others remain; the native machine has ReasonCleared.",
      "python": { "clearCandidates": [] },
      "native": { "hasReasonCleared": true },
      "contractGap": "CONTRACT_GAP-1",
      "resolution": "Native keeps a reason SET and releases per reason; recovery to ALLOW still requires a validated rearm."
    },
    {
      "id": "D06_generation_and_session_scope_absent_in_python",
      "description": "Python has no generation/session concept, so stale-generation and stale-token fail-closed behaviour cannot be derived from it.",
      "python": { "generationApi": [], "payloadHasGeneration": false },
      "native": { "generationScoped": true, "staleGenerationFailClosed": true },
      "contractGap": "CONTRACT_GAP-5",
      "resolution": "Native scopes the whole machine and every rearm token to a generation."
    },
    {
      "id": "D07_rearm_does_not_clear_native_reasons",
      "description": "Python rearm clears its single active reason; native rearm never clears effective reasons and requires independent reason release first.",
      "python": { "rearmWithActiveReason": "allows" },
      "native": { "rearmWithActiveReason": "REJECTED_ACTIVE_REASONS" },
      "contractGap": "CONTRACT_GAP-7",
      "resolution": "Shared parity excludes this extension; native callers must clear each active reason, validate the current session when required, and then rearm."
    }
  ]
}
