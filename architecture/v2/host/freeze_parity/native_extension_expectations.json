        { "step": 2, "rejected": true, "errorCode": "ERR_MISSING_SESSION" },
        { "step": 3, "rejected": true, "outcome": "REJECTED_MISSING_SESSION" }
      ],
      "final": { "isFrozen": false, "scanPermitted": true, "activeReasons": [], "blockedCount": 1, "executedCount": 0, "actuatorCallCount": 0 }
    },
    {
      "scenarioId": "N18_freeze_round_expires_credential",
      "assertions": [
