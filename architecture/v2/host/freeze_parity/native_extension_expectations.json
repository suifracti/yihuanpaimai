      ],
      "final": { "isFrozen": true, "scanPermitted": false, "activeReasons": ["GAME_INTERACTION_CONFLICT"], "blockedCount": 1, "executedCount": 0, "actuatorCallCount": 0 }
    },
    {
      "scenarioId": "N14_stale_generation_reason_clear_refused",
      "assertions": [
        { "step": 2, "applied": false, "state": { "isFrozen": true, "activeReasons": ["SESSION_UNVERIFIED"], "generationId": 5 } },
        { "step": 3, "executed": false, "actuatorCalled": false }
      ],
      "final": { "isFrozen": true, "scanPermitted": false, "activeReasons": ["SESSION_UNVERIFIED"], "generationId": 5, "blockedCount": 1, "executedCount": 0, "actuatorCallCount": 0 }
    },
    {
      "scenarioId": "N15_trace_records_every_event_in_order",
      "assertions": [
        { "step": 2, "applied": true, "state": { "isFrozen": true, "activeReasons": [], "awaitingRearm": true } },
        { "step": 3, "outcome": "REJECTED_CRITERIA", "state": { "isFrozen": true, "activeReasons": [] } },
        { "step": 4, "outcome": "APPLIED", "state": { "isFrozen": false, "activeReasons": [], "scanPermitted": true } },
        { "step": 5, "executed": true, "actuatorCalled": true, "state": { "actuatorCallCount": 1 } }
      ],
      "final": { "isFrozen": false, "scanPermitted": true, "activeReasons": [], "blockedCount": 0, "executedCount": 1, "actuatorCallCount": 1 }
    },
    {
      "scenarioId": "N16_unknown_reason_and_event_fail_closed",
      "assertions": [
        { "step": 2, "rejected": true, "errorCode": "ERR_UNKNOWN_REASON", "state": { "isFrozen": true, "activeReasons": ["FOCUS_LOST"] } },
        { "step": 3, "rejected": true, "errorCode": "ERR_UNKNOWN_EVENT", "state": { "isFrozen": true, "activeReasons": ["FOCUS_LOST"] } },
        { "step": 4, "executed": false, "actuatorCalled": false }
      ],
      "final": { "isFrozen": true, "scanPermitted": false, "activeReasons": ["FOCUS_LOST"], "blockedCount": 1, "executedCount": 0, "actuatorCallCount": 0 }
