        { "step": 1, "executed": false, "actuatorCalled": false }
      ],
      "final": { "isFrozen": true, "scanPermitted": false, "activeReasons": ["SESSION_UNVERIFIED"], "blockedCount": 1, "executedCount": 0, "actuatorCallCount": 0 }
