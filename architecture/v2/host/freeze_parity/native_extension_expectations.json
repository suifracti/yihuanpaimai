{
  "schemaVersion": "v2.2c.freeze.native-extension-expectations.v1",
  "scope": "NATIVE_EXTENSION only; never used to relax PYTHON_PARITY comparisons",
  "expectations": [
    {
      "scenarioId": "N01_multi_reason_coexist_still_frozen",
      "assertions": [
        { "step": 2, "state": { "isFrozen": true, "activeReasons": ["FOCUS_LOST", "USER_TAKEOVER"], "actuatorCallCount": 0 } },
        { "step": 3, "state": { "isFrozen": true, "activeReasons": ["USER_TAKEOVER"], "actuatorCallCount": 0 } },
        { "step": 4, "executed": false, "actuatorCalled": false, "state": { "isFrozen": true, "scanPermitted": false } }
      ],
      "final": { "isFrozen": true, "scanPermitted": false, "activeReasons": ["USER_TAKEOVER"], "blockedCount": 1, "executedCount": 0, "actuatorCallCount": 0 }
    },
    {
      "scenarioId": "N02_release_last_reason_does_not_auto_resume",
      "assertions": [
        { "step": 2, "state": { "isFrozen": true, "activeReasons": [], "awaitingRearm": true, "actuatorCallCount": 0 } },
        { "step": 3, "executed": false, "actuatorCalled": false },
        { "step": 4, "outcome": "APPLIED", "state": { "isFrozen": false, "activeReasons": [], "scanPermitted": true } },
        { "step": 5, "executed": true, "actuatorCalled": true, "state": { "actuatorCallCount": 1 } }
      ],
      "final": { "isFrozen": false, "scanPermitted": true, "activeReasons": [], "blockedCount": 1, "executedCount": 1, "actuatorCallCount": 1 }
    },
    {
      "scenarioId": "N03_stale_generation_rearm_fail_closed",
      "assertions": [
        { "step": 2, "outcome": "REJECTED_STALE_GENERATION", "state": { "isFrozen": true, "activeReasons": ["SESSION_UNVERIFIED"], "generationId": 2 } },
        { "step": 3, "executed": false, "actuatorCalled": false, "state": { "blockedCount": 1 } }
      ],
      "final": { "isFrozen": true, "scanPermitted": false, "activeReasons": ["SESSION_UNVERIFIED"], "generationId": 2, "blockedCount": 1, "executedCount": 0, "actuatorCallCount": 0 }
    },
    {
      "scenarioId": "N04_session_change_old_token_cannot_unfreeze_new_session",
      "assertions": [
        { "step": 3, "outcome": "REJECTED_STALE_TOKEN", "state": { "isFrozen": true, "activeReasons": ["SESSION_UNVERIFIED"], "generationId": 2 } },
        { "step": 4, "executed": false, "actuatorCalled": false }
      ],
      "final": { "isFrozen": true, "scanPermitted": false, "activeReasons": ["SESSION_UNVERIFIED"], "generationId": 2, "blockedCount": 1, "executedCount": 0, "actuatorCallCount": 0 }
    },
    {
      "scenarioId": "N05_session_change_is_frozen_until_rearmed",
      "assertions": [
        { "step": 2, "validated": true, "state": { "isFrozen": true, "activeReasons": [], "awaitingRearm": true, "generationId": 7 } },
        { "step": 3, "executed": false, "actuatorCalled": false },
        { "step": 5, "outcome": "APPLIED", "state": { "isFrozen": false, "activeReasons": [], "scanPermitted": true, "generationId": 7 } },
        { "step": 6, "executed": true, "actuatorCalled": true, "state": { "actuatorCallCount": 1 } }
      ],
      "final": { "isFrozen": false, "scanPermitted": true, "activeReasons": [], "generationId": 7, "blockedCount": 1, "executedCount": 1, "actuatorCallCount": 1 }
    },
    {
      "scenarioId": "N06_stale_generation_scan_request_denied",
      "assertions": [
