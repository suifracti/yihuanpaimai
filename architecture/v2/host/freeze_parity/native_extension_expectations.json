      ],
      "final": { "isFrozen": true, "scanPermitted": false, "activeReasons": ["EXPLICIT_FREEZE"], "blockedCount": 1, "executedCount": 0, "actuatorCallCount": 0 }
    },
    {
      "scenarioId": "N13_clear_unknown_reason_is_noop",
      "assertions": [
