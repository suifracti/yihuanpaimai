{
  "schemaVersion": "message.catalog.v1",
  "protocolVersion": "1.0.0",
  "title": "NTE Host-Engine IPC Message Catalog - Single Source of Truth",
  "totalMessageTypes": 14,
  "singleSourceOfTruth": {
    "statement": "This catalog is the single schema truth for the V2-0 Host-Engine IPC control plane. No other document, golden vector or verifier may declare a divergent message schema.",
    "pythonAuthority": "architecture/v2/contracts/models.py (ENVELOPE_FIELD_TYPES, PAYLOAD_FIELD_TYPES, REQUIRED_PAYLOAD_FIELDS derived from it, FRAME_READY_HEADER_METADATA_FIELDS, validate_hello_fixed_geometry, validate_hello_ack_readiness, validate_state_snapshot)",
    "dotnetAuthority": "architecture/v2/verifier/ContractModels.cs (ContractConstants, FrameHeaderV1, MessageType, EngineReadiness, ...)",
    "machineVerification": "architecture/v2/contracts/schema_parity.py -> message_schema_parity.json (regenerated on every contract test run)",
    "driftPolicy": "FAIL_CLOSED. Any divergence between this catalog and the Python / .NET contract sources makes message_schema_parity.json report allPassed=false and fails the contract test suites."
  },
