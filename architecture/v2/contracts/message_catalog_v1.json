{
  "schemaVersion": "message.catalog.v1",
  "protocolVersion": "1.0.0",
  "totalMessageTypes": 14,
  "messages": [
    {
      "messageType": "HELLO",
      "direction": "Host -> Engine",
      "description": "Initial handshake initiation message sent by Native Host advertising protocol, capabilities, and ring buffer parameters.",
      "payloadSchema": {
        "hostVersion": "string",
        "supportedProtocols": ["string"],
        "sessionNonce": "string",
        "capabilities": {
          "type": "object",
          "additionalProperties": { "type": "string", "enum": ["AVAILABLE", "UNAVAILABLE", "EXPERIMENTAL", "NOT_MEASURED"] }
        },
        "frameBufferName": "string",
        "slotCount": "integer",
        "slotSizeBytes": "integer",
        "mapTotalSizeBytes": "integer"
      },
      "requiredPayloadFields": [
        "hostVersion",
        "supportedProtocols",
        "sessionNonce",
        "capabilities",
        "frameBufferName",
        "slotCount",
        "slotSizeBytes",
        "mapTotalSizeBytes"
      ]
    },
    {
      "messageType": "HELLO_ACK",
      "direction": "Engine -> Host",
      "description": "Handshake response from Python Engine negotiating protocol version, readiness state, and confirming ring buffer geometry.",
      "payloadSchema": {
        "engineVersion": "string",
        "negotiatedProtocol": "string",
        "status": { "type": "string", "enum": ["ACCEPTED", "REJECTED_VERSION", "REJECTED_CAPABILITY"] },
        "readiness": { "type": "string", "enum": ["STARTING", "LOADING", "READY", "DEGRADED", "FAILED"] },
        "enginePid": "integer",
        "slotCount": "integer",
        "slotSizeBytes": "integer",
        "mapTotalSizeBytes": "integer",
        "engineBusinessReady": "boolean"
      },
      "requiredPayloadFields": [
        "engineVersion",
        "negotiatedProtocol",
        "status",
        "readiness",
        "enginePid",
        "slotCount",
        "slotSizeBytes",
        "mapTotalSizeBytes",
        "engineBusinessReady"
      ]
    },
    {
      "messageType": "HEARTBEAT",
      "direction": "Bidirectional (Host <-> Engine)",
      "description": "Periodic liveness probe exchanged every 1000ms with 3000ms timeout threshold.",
      "payloadSchema": {
        "timestamp": "number",
        "state": { "type": "string", "enum": ["HEALTHY", "BUSY", "DEGRADED"] },
        "activeMatchId": "string|null"
      },
      "requiredPayloadFields": ["timestamp", "state"]
    },
    {
      "messageType": "FRAME_READY",
      "direction": "Host -> Engine",
      "description": "Notification that a new frame has been written to ring buffer slot bufferIndex. Metadata must exact-match MMF frame header.",
      "payloadSchema": {
        "sessionId": "string",
        "bufferIndex": "integer (0 <= bufferIndex < slotCount)",
        "sequence": "integer (int64)",
        "width": "integer",
        "height": "integer",
        "stride": "integer",
        "pixelFormat": "integer (1=BGRA8)",
        "bufferLength": "integer",
        "captureTimestampNs": "integer (int64)",
        "checksum": "integer"
      },
      "requiredPayloadFields": [
        "sessionId",
        "bufferIndex",
        "sequence",
        "width",
        "height",
        "stride",
        "pixelFormat",
        "bufferLength",
        "captureTimestampNs",
        "checksum"
      ]
    },
    {
      "messageType": "FRAME_ACK",
      "direction": "Engine -> Host",
      "description": "Slot release token emitted by Engine upon processing completion. Authorizes Host to transition slot back to FREE.",
      "payloadSchema": {
        "sessionId": "string",
        "bufferIndex": "integer (0 <= bufferIndex < slotCount)",
        "sequence": "integer (int64)",
        "status": { "type": "string", "enum": ["RELEASED", "CONSUMED", "SKIPPED", "CORRUPTED"] },
        "mappingLatencyMs": "number",
        "processingLatencyMs": "number"
      },
      "requiredPayloadFields": ["sessionId", "bufferIndex", "sequence", "status"]
    },
    {
      "messageType": "PERCEPTION_RESULT",
      "direction": "Engine -> Host",
      "description": "Structured visual intelligence result containing recognized bids, items, or scene classification.",
      "payloadSchema": {
        "frameSequence": "integer (int64)",
        "scene": "string",
        "inAuction": "boolean",
        "bids": {
          "type": "array",
          "items": {
            "seat": "integer",
            "price": "integer",
            "isWinning": "boolean"
          }
        },
        "intel": {
          "type": "array",
          "items": { "id": "string", "value": "string" }
        },
        "warehouseSummary": "object|null",
        "processingMs": "number"
      },
      "requiredPayloadFields": ["frameSequence", "scene", "inAuction", "bids"]
    },
    {
      "messageType": "ABORT_SCAN",
      "direction": "Host -> Engine",
      "description": "Immediate halt instruction emitted when user moves physical mouse, presses Escape, or window focus is lost.",
      "payloadSchema": {
        "reason": { "type": "string", "enum": ["USER_TAKEOVER", "FOCUS_LOST", "ESCAPE_KEY", "TARGET_CLOSED"] },
        "triggerTimestampNs": "integer (int64)"
      },
      "requiredPayloadFields": ["reason", "triggerTimestampNs"]
    },
    {
      "messageType": "COMMAND",
      "direction": "Host -> Engine",
      "description": "High-level user or UI intent submitted to Engine (deduplicated by (sessionId, commandId)).",
      "payloadSchema": {
        "commandId": "string",
        "action": "string",
        "parameters": "object",
        "expiresAtNs": "integer (int64)"
      },
      "requiredPayloadFields": ["commandId", "action", "parameters", "expiresAtNs"]
    },
    {
      "messageType": "COMMAND_RESULT",
      "direction": "Engine -> Host",
      "description": "Execution status and output of a previously submitted COMMAND.",
      "payloadSchema": {
        "commandId": "string",
        "status": { "type": "string", "enum": ["ACK", "REJECT", "EXPIRED", "STALE_SESSION", "DUPLICATE", "NOT_FOREGROUND", "FROZEN", "CAPABILITY_UNAVAILABLE", "FAILED"] },
        "errorDetails": "string|null",
        "resultData": "object|null"
      },
      "requiredPayloadFields": ["commandId", "status"]
    },
    {
      "messageType": "STATE_SNAPSHOT_REQUEST",
      "direction": "Host -> Engine",
      "description": "Request from Host to retrieve authoritative business state snapshot to resync projection.",
      "payloadSchema": {
        "sinceSequence": "integer (int64)|null",
        "includeDrafts": "boolean",
        "includeProjection": "boolean"
      },
      "requiredPayloadFields": ["includeDrafts"]
    },
    {
      "messageType": "STATE_SNAPSHOT",
      "direction": "Engine -> Host",
      "description": "Authoritative match and session projection payload sufficient to rebuild Host UI state.",
      "payloadSchema": {
        "snapshotSchemaVersion": "string",
        "snapshotSessionId": "string",
        "snapshotSequence": "integer (int64)",
        "businessReady": "boolean",
        "currentMatchProjection": {
          "type": "object",
          "required": ["matchState", "draftCount", "finalizedCount"]
        }
      },
      "requiredPayloadFields": [
        "snapshotSchemaVersion",
        "snapshotSessionId",
        "snapshotSequence",
        "businessReady",
        "currentMatchProjection"
      ]
    },
    {
      "messageType": "ENGINE_SHUTDOWN",
      "direction": "Host -> Engine",
      "description": "Graceful termination request issued by Host prior to application exit.",
      "payloadSchema": {
        "reason": "string",
        "timeoutMs": "integer"
      },
      "requiredPayloadFields": ["reason", "timeoutMs"]
    },
    {
      "messageType": "ENGINE_RESTARTING",
      "direction": "Engine -> Host",
      "description": "Self-diagnosed recovery signal emitted by Engine before controlled restart.",
      "payloadSchema": {
        "reason": "string",
        "exitCode": "integer"
      },
      "requiredPayloadFields": ["reason", "exitCode"]
    },
    {
      "messageType": "ERROR",
      "direction": "Bidirectional (Host <-> Engine)",
      "description": "Structured fail-closed error payload detailing protocol, transport, payload, authority, or capability violations.",
      "payloadSchema": {
        "errorCode": "string",
        "category": { "type": "string", "enum": ["PROTOCOL", "TRANSPORT", "PAYLOAD", "TIMEOUT", "AUTHORITY", "CAPABILITY"] },
        "message": "string",
        "faultingMessageId": "string|null",
        "isFatal": "boolean"
      },
      "requiredPayloadFields": ["errorCode", "category", "message", "isFatal"]
    }
  ]
}
