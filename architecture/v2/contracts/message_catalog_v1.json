  "ringBufferGeometry": {
    "policy": "FIXED_V1_CONSTANTS",
    "geometryIsNegotiated": false,
    "derivedFrom": "protocolVersion == \"1.0.0\"",
    "slotCount": 4,
    "maxWidth": 1920,
    "maxHeight": 1080,
    "slotPayloadCapacityBytes": 8294400,
    "headerSizeBytes": 64,
    "slotSizeBytes": 8294464,
    "slotAlignmentBytes": 64,
    "mapTotalSizeBytes": 33177856,
    "slotOffsetFormula": "slotOffset(index) = index * slotSizeBytes",
    "validIndexRange": "0 <= bufferIndex < 4",
    "handshakeDeclaration": "HELLO declares frameBufferName and frameBufferSize only. slotCount, slotSizeBytes and mapTotalSizeBytes are NEVER carried in HELLO or HELLO_ACK and are NEVER accepted, echoed or rejected through a negotiation message.",
    "engineValidation": "The Engine validates HELLO.frameBufferSize == mapTotalSizeBytes (33177856). A mismatch fails closed with ERR_RING_GEOMETRY_MISMATCH (category PROTOCOL, isFatal true).",
    "wordingRule": "No message in this catalog negotiates ring geometry. Geometry is validated against fixed v1 constants; the terms 'negotiate geometry' / 'acceptedSlotCount' / 'acceptedSlotSizeBytes' / 'acceptedMapTotalSizeBytes' do not exist in protocol 1.0.0."
  },
  "frameHeaderMetadataContract": {
    "appliesTo": "FRAME_READY",
    "validator": "architecture/v2/contracts/models.py::verify_frame_metadata_match(frame_ready_payload, header, expected_buffer_index=None)",
    "rule": "Every field in checkedFields MUST be present in the FRAME_READY payload and MUST equal the corresponding FrameHeaderV1 value read from ring slot bufferIndex. Comparison is exact equality: no coercion, no tolerance, no defaults.",
    "checkedFields": [
      "bufferIndex",
      "sequence",
      "width",
      "height",
      "stride",
      "pixelFormat",
      "bufferLength",
      "captureTimestampNs",
      "cornerChecksum"
    ],
    "bufferIndexSemantics": "bufferIndex selects the ring slot that was read. It is bounds-checked against the fixed v1 range 0 <= bufferIndex < 4 (ERR_SLOT_INDEX_OUT_OF_BOUNDS) and, when the reader supplies the slot it actually read, must match it exactly (ERR_FRAME_METADATA_MISMATCH).",
    "fieldNamingRule": "Payload field names are identical to FrameHeaderV1 field names. The corner checksum field is named cornerChecksum in both the payload and the shared-memory header; the bare name 'checksum' is not part of protocol 1.0.0.",
    "pixelFormatType": "integer enum, identical in type to FrameHeaderV1.pixelFormat (int32). The value 1 means BGRA8. The string form \"BGRA8\" is NOT a valid wire value.",
    "headerFieldsNotCarriedInPayload": [
      "magic",
      "headerVersion",
      "flags",
      "producerTimestampNs",
      "reserved"
    ],
    "errorCodes": {
      "bufferIndexBounds": "ERR_SLOT_INDEX_OUT_OF_BOUNDS",
      "metadataMismatch": "ERR_FRAME_METADATA_MISMATCH"
    }
  },
  "readinessContract": {
    "authoritativeField": "readiness",
    "owner": "HELLO_ACK",
    "enumSource": "messages[messageType == HELLO_ACK].payloadSchema.properties.readiness.enum",
    "enum": [
      "DEGRADED",
      "FAILED",
      "LOADING",
      "READY",
      "STARTING"
    ],
    "businessReadyProjection": "engineBusinessReady",
    "rule": "readiness is the single authoritative engine-readiness field. engineBusinessReady is its boolean READY-gate projection; the two may never contradict each other. HELLO_ACK status == ACCEPTED with readiness == READY requires engineBusinessReady == true; readiness in [STARTING, LOADING] or status != ACCEPTED requires engineBusinessReady == false. Violations fail closed with ERR_SCHEMA_VALIDATION_FAILED.",
    "validator": "architecture/v2/contracts/models.py::validate_hello_ack_readiness(hello_ack_payload)",
    "lifecycleReadyGate": {
      "source": "architecture/v2/contracts/lifecycle_recovery_v1.json -> readyGateRequirements.gates",
      "protocolNegotiated": "HELLO_ACK.status == ACCEPTED",
      "capabilitiesAccepted": "All mandatory capabilities AVAILABLE",
      "engineBusinessReady": "HELLO_ACK.engineBusinessReady == true (which per this contract implies HELLO_ACK.readiness == READY) or STATE_SNAPSHOT.businessReady == true",
      "snapshotRequirementSatisfied": "(isColdBoot == true and noRecoverableBusinessState == true) or STATE_SNAPSHOT validated during SYNCING"
    },
    "modelStatusNote": "There is no separate 'modelStatus' protocol field in protocol 1.0.0. Model / catalog load state is folded into readiness (LOADING -> READY / FAILED) precisely so that two fields can never express the same state without a defined relationship."
  },
  "failClosedErrorCodes": [
    "ERR_BUFFER_UNAVAILABLE",
    "ERR_COMMAND_ID_REUSE_MISMATCH",
    "ERR_CORRUPT_FRAME_MAGIC",
    "ERR_DUPLICATE_COMMAND",
    "ERR_FRAME_CAPACITY_EXCEEDED",
    "ERR_FRAME_METADATA_MISMATCH",
    "ERR_FRAME_PAYLOAD_TOO_SHORT",
    "ERR_INCOMPLETE_FRAME",
    "ERR_INVALID_STATE_TRANSITION",
    "ERR_MALFORMED_ENVELOPE",
    "ERR_MESSAGE_BEFORE_HANDSHAKE",
    "ERR_MESSAGE_TOO_LARGE",
    "ERR_MISSING_REQUIRED_FIELD",
    "ERR_PROTOCOL_VERSION_MISMATCH",
    "ERR_RING_GEOMETRY_MISMATCH",
    "ERR_SCHEMA_VALIDATION_FAILED",
    "ERR_SLOT_INDEX_OUT_OF_BOUNDS",
    "ERR_SLOT_NOT_LOCKED",
    "ERR_STALE_GENERATION",
    "ERR_STALE_SEQUENCE",
    "ERR_STALE_SESSION",
    "ERR_UNKNOWN_FRAME_ACK",
    "ERR_UNKNOWN_MESSAGE_TYPE",
    "ERR_UNSUPPORTED_PIXEL_FORMAT"
  ],
