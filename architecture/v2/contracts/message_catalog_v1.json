      "messageType": "HELLO",
      "direction": "Host -> Engine",
      "description": "Initial handshake initiation sent by the Native Host. Declares host version, supported protocol versions, session nonce, the full capability advertisement, and the fixed v1 ring buffer map name and total size. Ring geometry itself is NOT negotiated: slotCount / slotSizeBytes / mapTotalSizeBytes are derived by both peers from protocolVersion == \"1.0.0\" and are validated against fixed v1 constants.",
      "payloadSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hostVersion": {
            "type": "string",
            "required": true,
            "nullable": false
          },
          "supportedProtocols": {
            "type": "array",
            "required": true,
            "nullable": false,
            "items": {
              "type": "string",
              "required": true,
              "nullable": false
            }
          },
          "sessionNonce": {
            "type": "string",
            "required": true,
            "nullable": false
          },
          "capabilities": {
            "type": "object",
            "required": true,
            "nullable": false,
            "additionalProperties": {
              "type": "string",
              "required": true,
              "nullable": false,
              "enum": [
                "AVAILABLE",
                "EXPERIMENTAL",
                "NOT_MEASURED",
                "UNAVAILABLE"
              ]
            }
          },
          "frameBufferName": {
            "type": "string",
            "required": true,
            "nullable": false
          },
          "frameBufferSize": {
            "type": "integer",
            "required": true,
            "nullable": false
          }
        }
      },
      "requiredPayloadFields": [
